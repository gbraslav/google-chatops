# ─── Chat SDK / Google Chat adapter ──────────────────────────────────────────
# Service-account JSON (entire key file contents on one line) — app identity for sends.
# GOOGLE_CHAT_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# OR use Application Default Credentials instead of the line above:
# GOOGLE_CHAT_USE_ADC=true

# Inbound JWT audience = your Cloud project NUMBER. The adapter verifies that the
# Google-signed bearer token's audience matches this value. (Requirements §6.1/§12)
GOOGLE_CHAT_PROJECT_NUMBER=1234567890

# Public HTTPS URL of the webhook (used by Google for button-click routing).
GCHAT_ENDPOINT_URL=https://your-tunnel-host/api/webhooks/gchat

# DEV ONLY: skip inbound JWT verification so you can POST synthetic events with curl.
# Never enable in a shared/deployed environment.
ALLOW_INSECURE_EVENTS=false

# ─── Our server ──────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:5173
PORT=3978

# Used by the echo card's "Open web app" button.
WEB_APP_URL=http://localhost:5173

# SQLite recipient registry location (git-ignored, resettable by deletion).
DB_PATH=./data/spaces.db
