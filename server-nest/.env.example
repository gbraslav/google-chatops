# NestJS parallel server. Mirrors ../server/.env — see that file's comments for the
# Google Chat / ngrok / audience details. Key differences for running in parallel:

# Run on a different port so both servers can run at once.
PORT=3979

# App identity (same options as the Hono server).
# GOOGLE_CHAT_CREDENTIALS={...service-account JSON on one line...}
GOOGLE_CHAT_USE_ADC=true
GOOGLE_APPLICATION_CREDENTIALS=/Users/gabrielbraslavsky/dev/test-apps/google-chatops/sa-key.json

# Expected inbound JWT audience = the Chat console HTTP endpoint URL (add-on app),
# byte-for-byte. Only ONE Chat app can point at a given endpoint at a time, so to
# exercise this server against real Google you switch the endpoint/tunnel to it.
GOOGLE_CHAT_PROJECT_NUMBER=https://<sub>.ngrok-free.dev/api/webhooks/gchat
GCHAT_ENDPOINT_URL=https://<sub>.ngrok-free.dev/api/webhooks/gchat
PUBLIC_BASE_URL=https://<sub>.ngrok-free.dev

ALLOW_INSECURE_EVENTS=false
WEB_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Separate registry by default. Point at ../server/data/spaces.db to share recipients
# with the Hono server (avoid writing from both processes at once).
DB_PATH=./data/spaces.db
UPLOAD_DIR=./data/uploads
